APP_NAME="Manuscript Intelligence Archive"
APP_ENV=production
APP_DEBUG=true
APP_URL="http://localhost:8000"
APP_SECRET="your_secret_key_here"

# Database Configuration (MySQL 8.x)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=manuscript_archive
DB_USER=root
DB_PASS=root
DB_CHARSET=utf8mb4

# Storage Paths
STORAGE_PATH="storage"
UPLOAD_MAX_BYTES=26214400 # 25MB

# AI / External Services (Optional API key for live external AI translations)
GEMINI_API_KEY=""
TESSERACT_PATH=""
